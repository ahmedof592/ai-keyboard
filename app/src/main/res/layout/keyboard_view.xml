<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="#11111B"
    android:paddingStart="2dp"
    android:paddingEnd="2dp"
    android:paddingTop="3dp"
    android:paddingBottom="4dp">

    <!-- 1. شريط الحالة العلوي: يوضح المود الفعال واللغة والنمط بشكل صريح -->
    <TextView
        android:id="@+id/tvStatus"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="🟢 المود: تحسين الصياغة (نفس اللغة) | النمط: رسمي 👔"
        android:textColor="#CDD6F4"
        android:textSize="11sp"
        android:textStyle="bold"
        android:gravity="center"
        android:paddingTop="1dp"
        android:paddingBottom="3dp"
        android:singleLine="true" />

    <!-- 2. شريط التحكم الرئيسي: اختيار المود + المايكروفون + تنفيذ عالنص -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="34dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingBottom="2dp">

        <!-- زر تفعيل مود التحسين (نفس اللغة) -->
        <Button
            android:id="@+id/btnModeRefine"
            android:layout_width="0dp"
            android:layout_height="32dp"
            android:layout_weight="1.25"
            android:text="✨ مود التحسين"
            android:textSize="10.5sp"
            android:textStyle="bold"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:padding="0dp"
            android:layout_margin="1dp" />

        <!-- زر تفعيل مود الترجمة -->
        <Button
            android:id="@+id/btnModeTranslate"
            android:layout_width="0dp"
            android:layout_height="32dp"
            android:layout_weight="1.25"
            android:text="🌐 مود الترجمة"
            android:textSize="10.5sp"
            android:textStyle="bold"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:padding="0dp"
            android:layout_margin="1dp" />

        <!-- زر التسجيل الصوتي الموحد (ينفذ المود الفعال) -->
        <Button
            android:id="@+id/btnMicAction"
            android:layout_width="0dp"
            android:layout_height="32dp"
            android:layout_weight="1.15"
            android:text="🎤 تحدث"
            android:textSize="11sp"
            android:textStyle="bold"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:padding="0dp"
            android:layout_margin="1dp" />

        <!-- زر التنفيذ على النص المكتوب بالحروف -->
        <Button
            android:id="@+id/btnApplyText"
            android:layout_width="0dp"
            android:layout_height="32dp"
            android:layout_weight="0.95"
            android:text="⚡ نفّذ"
            android:textSize="11sp"
            android:textStyle="bold"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:padding="0dp"
            android:layout_margin="1dp" />

        <!-- زر تغيير الكيبورد -->
        <Button
            android:id="@+id/btnSwitchKeyboard"
            android:layout_width="0dp"
            android:layout_height="32dp"
            android:layout_weight="0.5"
            android:text="⌨️"
            android:textSize="12sp"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:padding="0dp"
            android:layout_margin="1dp" />
    </LinearLayout>

    <!-- 3. شريط الخيارات الفرعية الديناميكي (يعرض درجات الصياغة أو لغات الترجمة) -->
    <LinearLayout
        android:id="@+id/subOptionsContainer"
        android:layout_width="match_parent"
        android:layout_height="31dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingBottom="2dp" />

    <!-- 4. حاوية أزرار الكيبورد الكاملة (عربي / تركي / إنكليزي / رموز) -->
    <LinearLayout
        android:id="@+id/keyboardKeysLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingTop="1dp" />

</LinearLayout>
