<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="#181825"
    android:paddingStart="2dp"
    android:paddingEnd="2dp"
    android:paddingTop="3dp"
    android:paddingBottom="4dp">

    <!-- شريط الحالة المصغر -->
    <TextView
        android:id="@+id/tvStatus"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="جاهز.. اكتب أو تحدث ✨"
        android:textColor="#BAC2DE"
        android:textSize="11sp"
        android:gravity="center"
        android:paddingBottom="2dp"
        android:singleLine="true" />

    <!-- شريط الذكاء الاصطناعي فائق النحافة -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="33dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingBottom="2dp">

        <Button
            android:id="@+id/btnMic"
            android:layout_width="0dp"
            android:layout_height="32dp"
            android:layout_weight="1.2"
            android:backgroundTint="#F38BA8"
            android:text="🎤 تحدث"
            android:textColor="#11111B"
            android:textSize="11sp"
            android:textStyle="bold"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:padding="0dp"
            android:layout_margin="1dp" />

        <Button
            android:id="@+id/btnVoiceAr"
            android:layout_width="0dp"
            android:layout_height="32dp"
            android:layout_weight="0.7"
            android:backgroundTint="#313244"
            android:text="🇸🇦"
            android:textColor="#FFFFFF"
            android:textSize="11sp"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:padding="0dp"
            android:layout_margin="1dp" />

        <Button
            android:id="@+id/btnVoiceTr"
            android:layout_width="0dp"
            android:layout_height="32dp"
            android:layout_weight="0.7"
            android:backgroundTint="#313244"
            android:text="🇹🇷"
            android:textColor="#FFFFFF"
            android:textSize="11sp"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:padding="0dp"
            android:layout_margin="1dp" />

        <Button
            android:id="@+id/btnVoiceEn"
            android:layout_width="0dp"
            android:layout_height="32dp"
            android:layout_weight="0.7"
            android:backgroundTint="#313244"
            android:text="🇬🇧"
            android:textColor="#FFFFFF"
            android:textSize="11sp"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:padding="0dp"
            android:layout_margin="1dp" />

        <Button
            android:id="@+id/btnRewriteFormal"
            android:layout_width="0dp"
            android:layout_height="32dp"
            android:layout_weight="1.6"
            android:backgroundTint="#A6E3A1"
            android:text="✨ صياغة رسمية"
            android:textColor="#11111B"
            android:textSize="11sp"
            android:textStyle="bold"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:padding="0dp"
            android:layout_margin="1dp" />

        <Button
            android:id="@+id/btnSwitchKeyboard"
            android:layout_width="0dp"
            android:layout_height="32dp"
            android:layout_weight="0.7"
            android:backgroundTint="#89B4FA"
            android:text="⌨️"
            android:textColor="#11111B"
            android:textSize="12sp"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:padding="0dp"
            android:layout_margin="1dp" />
    </LinearLayout>

    <!-- مكان ظهور الحروف ومفاتيح الكتابة -->
    <LinearLayout
        android:id="@+id/keyboardKeysLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingTop="1dp" />

</LinearLayout>
