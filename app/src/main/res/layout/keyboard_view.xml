<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="#181825"
    android:paddingStart="2dp"
    android:paddingEnd="2dp"
    android:paddingTop="3dp"
    android:paddingBottom="4dp">

    <!-- شريط الحالة العريض لتوضيح المود بوضوح تام -->
    <TextView
        android:id="@+id/tvStatus"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="جاهز.. اختر المود للتحدث أو اكتب بالحروف ✨"
        android:textColor="#BAC2DE"
        android:textSize="11.5sp"
        android:textStyle="bold"
        android:gravity="center"
        android:paddingTop="1dp"
        android:paddingBottom="3dp"
        android:singleLine="true" />

    <!-- شريط الأوضاع المستقلة (ارتفاع مدمج 34dp) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="34dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingBottom="2dp">

        <!-- مود الصياغة الصوتية (نفس اللغة) -->
        <Button
            android:id="@+id/btnMicRefine"
            android:layout_width="0dp"
            android:layout_height="33dp"
            android:layout_weight="1.3"
            android:backgroundTint="#F38BA8"
            android:text="🎤✨ صياغة"
            android:textColor="#11111B"
            android:textSize="11sp"
            android:textStyle="bold"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:padding="0dp"
            android:layout_margin="1dp" />

        <!-- مود الترجمة الصوتية إلى التركية -->
        <Button
            android:id="@+id/btnMicTr"
            android:layout_width="0dp"
            android:layout_height="33dp"
            android:layout_weight="1.1"
            android:backgroundTint="#313244"
            android:text="🎤🇹🇷 تركي"
            android:textColor="#FFFFFF"
            android:textSize="10.5sp"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:padding="0dp"
            android:layout_margin="1dp" />

        <!-- مود الترجمة الصوتية إلى الإنكليزية -->
        <Button
            android:id="@+id/btnMicEn"
            android:layout_width="0dp"
            android:layout_height="33dp"
            android:layout_weight="1.1"
            android:backgroundTint="#313244"
            android:text="🎤🇬🇧 EN"
            android:textColor="#FFFFFF"
            android:textSize="10.5sp"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:padding="0dp"
            android:layout_margin="1dp" />

        <!-- مود صياغة وتصحيح النص المكتوب بالحروف -->
        <Button
            android:id="@+id/btnRewriteText"
            android:layout_width="0dp"
            android:layout_height="33dp"
            android:layout_weight="1.2"
            android:backgroundTint="#A6E3A1"
            android:text="📝 تحسين"
            android:textColor="#11111B"
            android:textSize="11sp"
            android:textStyle="bold"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:padding="0dp"
            android:layout_margin="1dp" />

        <!-- زر التبديل لكيبورد سامسونج -->
        <Button
            android:id="@+id/btnSwitchKeyboard"
            android:layout_width="0dp"
            android:layout_height="33dp"
            android:layout_weight="0.6"
            android:backgroundTint="#89B4FA"
            android:text="⌨️"
            android:textColor="#11111B"
            android:textSize="12sp"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:padding="0dp"
            android:layout_margin="1dp" />
    </LinearLayout>

    <!-- حاوية أزرار الحروف الكاملة -->
    <LinearLayout
        android:id="@+id/keyboardKeysLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingTop="1dp" />

</LinearLayout>
